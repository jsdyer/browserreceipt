[Unit]
Description=CoolCode optional authoritative DNS observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/coolcode-dns-observer.env
ExecStart=/usr/bin/python3 /opt/coolcode-dns-observer/server.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=96M
TasksMax=32
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
